---
interface Props {
  track: string;
  size?: 'sm' | 'md' | 'lg';
}

const { track, size = 'md' } = Astro.props;

const dims = {
  sm: 'h-9 w-9 rounded-xl',
  md: 'h-12 w-12 rounded-2xl',
  lg: 'h-14 w-14 rounded-2xl',
}[size];

const iconDims = {
  sm: 'h-4 w-4',
  md: 'h-6 w-6',
  lg: 'h-7 w-7',
}[size];

const textDims = {
  sm: 'text-xs',
  md: 'text-sm',
  lg: 'text-base',
}[size];

const palette: Record<string, string> = {
  HTML: 'from-[#f97316] to-[#ea580c]',
  CSS: 'from-[#3b82f6] to-[#2563eb]',
  JavaScript: 'from-[#eab308] to-[#ca8a04]',
  SQL: 'from-[#8b5cf6] to-[#7c3aed]',
  PHP: 'from-[#6366f1] to-[#4f46e5]',
  Python: 'from-[#10b981] to-[#059669]',
  Git: 'from-[#ef4444] to-[#dc2626]',
  OOP: 'from-[#0ea5e9] to-[#0284c7]',
  C: 'from-[#475569] to-[#334155]',
  'C++': 'from-[#2563eb] to-[#1d4ed8]',
  Java: 'from-[#f59e0b] to-[#d97706]',
  'C#': 'from-[#9333ea] to-[#7e22ce]',
  TypeScript: 'from-[#0284c7] to-[#0369a1]',
  React: 'from-[#06b6d4] to-[#0891b2]',
  'Node.js': 'from-[#22c55e] to-[#15803d]',
  Linux: 'from-[#52525b] to-[#27272a]',
  Docker: 'from-[#38bdf8] to-[#0284c7]',
  DSA: 'from-[#f43f5e] to-[#be123c]',
  Go: 'from-[#06b6d4] to-[#0e7490]',
  PostgreSQL: 'from-[#336791] to-[#1e3a5f]',
  'System Design': 'from-[#7c3aed] to-[#5b21b6]',
  'Next.js': 'from-[#27272a] to-[#09090b]',
};

const gradient = palette[track] ?? 'from-[#3b82f6] to-[#2563eb]';
---

<div
  class={`inline-flex shrink-0 items-center justify-center bg-gradient-to-b ${gradient} text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.35)] ${dims}`}
  aria-hidden="true"
>
  {track === 'HTML' ? (
    <svg class={iconDims} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="16 18 22 12 16 6" />
      <polyline points="8 6 2 12 8 18" />
      <line x1="14" y1="4" x2="10" y2="20" />
    </svg>
  ) : track === 'CSS' ? (
    <svg class={iconDims} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="7" height="7" x="3" y="3" rx="1.5" />
      <rect width="7" height="7" x="14" y="3" rx="1.5" />
      <rect width="7" height="7" x="14" y="14" rx="1.5" />
      <rect width="7" height="7" x="3" y="14" rx="1.5" />
    </svg>
  ) : track === 'SQL' ? (
    <svg class={iconDims} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <ellipse cx="12" cy="5" rx="9" ry="3" />
      <path d="M3 5v14a9 3 0 0 0 18 0V5" />
      <path d="M3 12a9 3 0 0 0 18 0" />
    </svg>
  ) : track === 'PHP' ? (
    <svg class={iconDims} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="20" height="8" x="2" y="2" rx="2" ry="2" />
      <rect width="20" height="8" x="2" y="14" rx="2" ry="2" />
      <line x1="6" x2="6.01" y1="6" y2="6" />
      <line x1="6" x2="6.01" y1="18" y2="18" />
    </svg>
  ) : track === 'Python' ? (
    <svg class={iconDims} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="4 17 10 11 4 5" />
      <line x1="12" y1="19" x2="20" y2="19" />
    </svg>
  ) : track === 'Git' ? (
    <svg class={iconDims} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="18" cy="18" r="3" />
      <circle cx="6" cy="6" r="3" />
      <path d="M13 6h3a2 2 0 0 1 2 2v7" />
      <line x1="6" y1="9" x2="6" y2="21" />
    </svg>
  ) : track === 'OOP' ? (
    <svg class={iconDims} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
      <path d="m3.3 7 8.7 5 8.7-5" />
      <path d="M12 22V12" />
    </svg>
  ) : track === 'C' || track === 'C++' || track === 'C#' || track === 'DSA' || track === 'Go' ? (
    <span class={`font-mono font-black tracking-tighter ${textDims}`}>{track}</span>
  ) : track === 'PostgreSQL' ? (
    <span class={`font-mono font-black tracking-tighter ${textDims}`}>PG</span>
  ) : track === 'Next.js' ? (
    <span class={`font-mono font-black tracking-tighter ${textDims}`}>NX</span>
  ) : track === 'System Design' ? (
    <svg class={iconDims} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="3" width="6" height="6" rx="1.5" />
      <rect x="16" y="3" width="6" height="6" rx="1.5" />
      <rect x="9" y="15" width="6" height="6" rx="1.5" />
      <path d="M5 9v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9" />
      <path d="M12 14v1" />
    </svg>
  ) : track === 'TypeScript' ? (
    <span class={`font-mono font-black tracking-tighter ${textDims}`}>TS</span>
  ) : track === 'React' ? (
    <svg class={iconDims} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="2.2" />
      <ellipse cx="12" cy="12" rx="9" ry="4" />
      <ellipse cx="12" cy="12" rx="9" ry="4" transform="rotate(60 12 12)" />
      <ellipse cx="12" cy="12" rx="9" ry="4" transform="rotate(120 12 12)" />
    </svg>
  ) : track === 'Node.js' ? (
    <svg class={iconDims} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z" />
      <path d="M9 15V9l6 6V9" />
    </svg>
  ) : track === 'Linux' ? (
    <svg class={iconDims} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="20" height="16" x="2" y="4" rx="2" />
      <path d="m7 10 3 2-3 2" />
      <path d="M13 14h4" />
    </svg>
  ) : track === 'Docker' ? (
    <svg class={iconDims} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
      <polyline points="7.5 4.21 12 6.81 16.5 4.21" />
      <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
      <line x1="12" y1="22.08" x2="12" y2="12" />
    </svg>
  ) : track === 'Java' ? (
    <svg class={iconDims} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 2v2" />
      <path d="M14 2v2" />
      <path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1" />
      <path d="M6 2v2" />
    </svg>
  ) : (
    <svg class={iconDims} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1" />
      <path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1" />
    </svg>
  )}
</div>
