---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CourseProgressBar from '@/components/progress/CourseProgressBar';
import TrackIcon from '@/components/ui/TrackIcon.astro';
import { getAllCoursesSorted, getCourseLessons, getLessonSlug, groupLessonsByModule } from '@/lib/courses';

export async function getStaticPaths() {
  const courses = await getAllCoursesSorted();
  return courses.map((course) => ({
    params: { course: course.data.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
const lessons = await getCourseLessons(course.data.slug);
const modules = groupLessonsByModule(course.data.slug, lessons);
const firstLesson = lessons[0];
const startHref = firstLesson
  ? `/courses/${course.data.slug}/${getLessonSlug(firstLesson)}`
  : `/courses/${course.data.slug}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: course.data.title,
  description: course.data.description,
  url: new URL(`/courses/${course.data.slug}/`, Astro.site).toString(),
  isAccessibleForFree: true,
  educationalLevel: course.data.difficulty,
  timeRequired: `PT${course.data.estimatedHours}H`,
  inLanguage: 'en',
  provider: {
    '@type': 'Organization',
    name: 'DevPath',
    sameAs: 'https://devpath.mycampus.ph',
  },
  offers: {
    '@type': 'Offer',
    category: 'Free',
    price: '0',
    priceCurrency: 'USD',
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Online',
    courseWorkload: `PT${course.data.estimatedHours}H`,
  },
  syllabusSections: modules.map((m) => ({
    '@type': 'Syllabus',
    name: m.name,
    description: m.lessons.map((l) => l.entry.data.title).join(', '),
  })),
};
---

<BaseLayout title={course.data.title} description={course.data.description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8" data-pagefind-body>
    <a href="/courses" class="text-xs font-semibold uppercase tracking-wider text-[var(--accent)] hover:underline">
      ← All Courses
    </a>

    <header class="mt-4 rounded-3xl bg-[var(--bg-elevated)] p-8">
      <div class="flex flex-wrap items-center gap-3">
        <TrackIcon track={course.data.track} size="lg" />
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full bg-[var(--bg-muted)] px-3 py-1 text-xs font-semibold text-[var(--text)]">
            {course.data.track}
          </span>
          <span class="rounded-full bg-[var(--bg-muted)] px-3 py-1 text-xs font-medium text-[var(--text-muted)]">
            {course.data.difficulty}
          </span>
          <span class="text-xs text-[var(--text-subtle)]">
            ~{course.data.estimatedHours} hours · {lessons.length} lessons · Free
          </span>
        </div>
      </div>

      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-[var(--text)] sm:text-4xl">
        {course.data.title}
      </h1>
      <p class="mt-3 max-w-2xl text-base text-[var(--text-muted)]">
        {course.data.description}
      </p>

      <div class="mt-6 max-w-md">
        <CourseProgressBar client:load courseSlug={course.data.slug} totalLessons={lessons.length} />
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={startHref}
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-2xl bg-[var(--accent)] px-6 py-3.5 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-[var(--accent-strong)] active:scale-[0.98]"
        >
          <span>Start First Lesson</span>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
        <a
          href={`/courses/${course.data.slug}/exam`}
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-2xl bg-[var(--bg-muted)] px-6 py-3.5 text-sm font-semibold text-[var(--text)] transition hover:-translate-y-0.5 active:scale-[0.98]"
        >
          <svg class="h-4 w-4 text-[var(--accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="6" />
            <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
          </svg>
          <span>Final Exam &amp; Free Certificate</span>
        </a>
      </div>
    </header>

    {course.data.outcomes.length > 0 && (
      <section class="mt-8 rounded-3xl bg-[var(--bg-elevated)] p-7">
        <h2 class="text-lg font-bold text-[var(--text)]">What you'll build & master</h2>
        <ul class="mt-4 grid grid-cols-1 gap-3 text-sm text-[var(--text-muted)] sm:grid-cols-2">
          {course.data.outcomes.map((item) => (
            <li class="flex items-start gap-2.5">
              <span class="font-bold text-[var(--success)]">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-12" aria-labelledby="syllabus-heading">
      <h2 id="syllabus-heading" class="text-2xl font-extrabold tracking-tight text-[var(--text)]">
        Course Syllabus
      </h2>

      <div class="mt-6 space-y-6">
        {modules.map((mod, mIdx) => (
          <div class="overflow-hidden rounded-3xl bg-[var(--bg-elevated)]">
            <div class="px-6 pt-5 pb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--accent)]">
                Module {mIdx + 1}
              </span>
              <h3 class="text-base font-bold text-[var(--text)]">{mod.name}</h3>
            </div>
            <ul class="divide-y divide-[var(--border)]">
              {mod.lessons.map((item, lIdx) => (
                <li>
                  <a
                    href={item.href}
                    class="flex items-center justify-between gap-4 px-6 py-4 transition hover:bg-[var(--bg)]/60"
                  >
                    <div class="flex items-start gap-3">
                      <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--bg-muted)] text-xs font-bold text-[var(--text-muted)]">
                        {lIdx + 1}
                      </span>
                      <div>
                        <p class="text-sm font-semibold text-[var(--text)]">{item.entry.data.title}</p>
                        <p class="mt-0.5 text-xs text-[var(--text-muted)]">{item.entry.data.description}</p>
                      </div>
                    </div>
                    <span class="shrink-0 text-xs font-medium text-[var(--text-subtle)]">
                      {item.entry.data.durationMinutes} min
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
