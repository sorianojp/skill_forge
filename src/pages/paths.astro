---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TrackIcon from '@/components/ui/TrackIcon.astro';
import { CAREER_PATHS } from '@/data/paths';
import { getAllCoursesSorted, getCourseLessons, getLessonSlug } from '@/lib/courses';

const allCourses = await getAllCoursesSorted();
const courseMap = new Map(allCourses.map((c) => [c.data.slug, c]));

const enrichedPaths = await Promise.all(
  CAREER_PATHS.map(async (path) => {
    const steps = await Promise.all(
      path.courseSlugs.map(async (slug) => {
        const course = courseMap.get(slug);
        if (!course) return null;
        const lessons = await getCourseLessons(slug);
        const first = lessons[0];
        return {
          course,
          lessonCount: lessons.length,
          startHref: first ? `/courses/${slug}/${getLessonSlug(first)}` : `/courses/${slug}`,
        };
      })
    );
    const validSteps = steps.filter((s): s is NonNullable<typeof s> => Boolean(s));
    const totalLessons = validSteps.reduce((sum, s) => sum + s.lessonCount, 0);
    const totalHours = validSteps.reduce((sum, s) => sum + s.course.data.estimatedHours, 0);
    return { ...path, steps: validSteps, totalLessons, totalHours };
  })
);
---

<BaseLayout
  title="Career Learning Paths"
  description="Follow curated multi-course learning paths on SkillForge: Frontend Developer, Full-Stack Web Developer, and Data & Backend Foundations."
>
  <div class="mx-auto max-w-[82rem] px-5 py-12 sm:px-6 lg:px-8" data-pagefind-body>
    <header class="mb-10 max-w-2xl">
      <h1 class="text-3xl font-extrabold tracking-tight text-[var(--text)] sm:text-4xl">
        Career Learning Paths
      </h1>
      <p class="mt-2 text-base text-[var(--text-muted)]">
        Follow a step-by-step sequence of free courses designed to take you from fundamentals to real-world projects.
      </p>
    </header>

    <div class="space-y-8">
      {enrichedPaths.map((path) => (
        <section class="rounded-3xl bg-[var(--bg-elevated)] p-7 sm:p-8">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="max-w-2xl">
              <span
                class="inline-block rounded-full px-3 py-1 text-xs font-bold text-white"
                style={`background-color: ${path.accentColor}`}
              >
                {path.tagline}
              </span>
              <h2 class="mt-3 text-2xl font-extrabold text-[var(--text)]">{path.title}</h2>
              <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-muted)]">{path.description}</p>
            </div>

            <div class="flex items-center gap-3 text-xs font-semibold text-[var(--text-subtle)]">
              <span class="rounded-full bg-[var(--bg-muted)] px-3 py-1.5">
                {path.steps.length} courses · {path.totalLessons} lessons · ~{path.totalHours}h
              </span>
              {path.steps[0] && (
                <a
                  href={path.steps[0].startHref}
                  class="inline-flex min-h-11 items-center gap-1.5 rounded-2xl bg-[var(--accent)] px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-[var(--accent-strong)]"
                >
                  <span>Start Path</span>
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </a>
              )}
            </div>
          </div>

          <ol class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {path.steps.map((step, idx) => (
              <li>
                <a
                  href={`/courses/${step.course.data.slug}`}
                  class="flex items-center gap-3.5 rounded-2xl bg-[var(--bg)] p-4 transition hover:-translate-y-0.5"
                >
                  <TrackIcon track={step.course.data.track} size="sm" />
                  <div class="min-w-0">
                    <div class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-subtle)]">
                      Step {idx + 1} · {step.lessonCount} lessons
                    </div>
                    <div class="truncate text-sm font-bold text-[var(--text)]">
                      {step.course.data.title}
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
