---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const refs = await getCollection('references');
  return refs.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title}: ${entry.data.category} Reference`} description={entry.data.summary}>
  <article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8" data-pagefind-body>
    <a href="/reference" class="text-xs font-semibold uppercase tracking-wider text-[var(--accent)] hover:underline">
      ← All References
    </a>

    <header class="mt-4 pb-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-[var(--accent-soft)] px-3 py-0.5 text-xs font-bold text-[var(--accent)]">
          {entry.data.category}
        </span>
        <span class="rounded-full bg-[var(--success-soft)] px-3 py-0.5 text-xs font-semibold text-[var(--success)]">
          {entry.data.browserSupport}
        </span>
      </div>
      <h1 class="mt-3 font-mono text-3xl font-extrabold text-[var(--text)]">{entry.data.title}</h1>
      <p class="mt-2 text-base text-[var(--text-muted)]">{entry.data.summary}</p>
      <div class="mt-4 rounded-2xl bg-[var(--bg-elevated)] px-4 py-3 font-mono text-xs text-[var(--text)]">
        {entry.data.syntax}
      </div>
    </header>

    <div class="lesson-prose prose prose-slate mt-8 max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>
</BaseLayout>
