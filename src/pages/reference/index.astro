---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TrackIcon from '@/components/ui/TrackIcon.astro';
import { getCollection } from 'astro:content';

const refs = await getCollection('references');
const categories = [
  'HTML',
  'CSS',
  'JavaScript',
  'SQL',
  'PHP',
  'Python',
  'Git',
  'OOP',
  'C',
  'C++',
  'Java',
  'C#',
] as const;
---

<BaseLayout title="Quick Reference" description="Fast, scannable cheat sheets for HTML, CSS, and JavaScript.">
  <div class="mx-auto max-w-[82rem] px-5 py-12 sm:px-6 lg:px-8">
    <header class="mb-10 max-w-2xl">
      <h1 class="text-3xl font-extrabold tracking-tight text-[var(--text)] sm:text-4xl">
        Quick Reference
      </h1>
      <p class="mt-2 text-base text-[var(--text-muted)]">
        Bite-sized lookup tables and syntax examples for everyday web development.
      </p>
    </header>

    <div class="space-y-12">
      {categories.map((cat) => {
        const items = refs.filter((r) => r.data.category === cat);
        if (items.length === 0) return null;
        return (
          <section>
            <div class="flex items-center gap-3">
              <TrackIcon track={cat} size="sm" />
              <h2 class="text-xl font-bold text-[var(--text)]">{cat}</h2>
            </div>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {items.map((item) => (
                <a
                  href={`/reference/${item.id.replace(/\.mdx$/, '')}`}
                  class="rounded-2xl bg-[var(--bg-elevated)] p-6 transition hover:-translate-y-0.5"
                >
                  <div class="flex items-center justify-between gap-2">
                    <h3 class="font-mono text-base font-bold text-[var(--text)]">{item.data.title}</h3>
                    <span class="rounded-full bg-[var(--success-soft)] px-2.5 py-0.5 text-[10px] font-semibold text-[var(--success)]">
                      {item.data.browserSupport}
                    </span>
                  </div>
                  <p class="mt-2 text-xs leading-relaxed text-[var(--text-muted)]">{item.data.summary}</p>
                  <code class="mt-3 block truncate rounded-xl bg-[var(--bg-muted)] px-3 py-2 text-[11px] text-[var(--accent)]">
                    {item.data.syntax}
                  </code>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>
