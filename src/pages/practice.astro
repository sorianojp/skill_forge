---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PracticeArena from '@/components/practice/PracticeArena';
---

<BaseLayout
  title="Coding Practice Arena"
  description="Solve auto-graded coding challenges in JavaScript, TypeScript, Node.js, C, C++, Java 21, and C# to build your daily streak."
>
  <section class="mx-auto max-w-[82rem] px-5 py-12 sm:px-6 lg:px-8">
    <header class="mb-8 max-w-2xl">
      <span class="inline-flex items-center rounded-full bg-[var(--accent-soft)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-[var(--accent)]">
        Auto-Graded Challenges
      </span>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-[var(--text)] sm:text-4xl">
        Coding Practice Arena
      </h1>
      <p class="mt-2 text-base text-[var(--text-muted)]">
        Sharpen your algorithmic and language skills with instant live grading across JavaScript, TypeScript, Node.js, C, C++, Java 21, and C#.
      </p>
    </header>

    <PracticeArena client:load />
  </section>
</BaseLayout>
