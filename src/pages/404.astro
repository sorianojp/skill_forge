---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you are looking for could not be found on DevPath."
  noindex={true}
>
  <div class="mx-auto max-w-2xl px-5 py-20 text-center sm:px-6 lg:px-8">
    <p class="font-mono text-sm font-bold uppercase tracking-wider text-[var(--accent)]">Error 404</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-[var(--text)] sm:text-5xl">
      Page not found
    </h1>
    <p class="mt-3 text-base text-[var(--text-muted)]">
      That URL may have moved or never existed. Jump back into a track, open the live playground, or search all 264 lessons.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/courses"
        class="inline-flex min-h-12 items-center gap-2 rounded-2xl bg-[var(--accent)] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[var(--accent-strong)]"
      >
        Browse All 21 Courses
      </a>
      <button
        type="button"
        data-open-search
        class="inline-flex min-h-12 items-center gap-2 rounded-2xl bg-[var(--bg-elevated)] px-6 py-3 text-sm font-semibold text-[var(--text)] transition hover:text-[var(--accent)]"
      >
        Search DevPath (⌘K)
      </button>
      <a
        href="/playground"
        class="inline-flex min-h-12 items-center gap-2 rounded-2xl bg-[var(--bg-elevated)] px-6 py-3 text-sm font-semibold text-[var(--text)] transition hover:text-[var(--accent)]"
      >
        Open Playground
      </a>
    </div>
  </div>
</BaseLayout>
