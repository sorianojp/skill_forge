---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdminDashboard from '@/components/admin/AdminDashboard';
---

<BaseLayout
  title="Admin Analytics"
  description="Private DevPath analytics dashboard."
  noindex={true}
>
  <section class="mx-auto max-w-[82rem] px-5 py-12 sm:px-6 lg:px-8">
    <header class="mb-8">
      <span class="inline-flex items-center rounded-full bg-[var(--accent-soft)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-[var(--accent)]">
        DevPath Admin
      </span>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-[var(--text)] sm:text-4xl">
        Platform Analytics
      </h1>
    </header>

    <AdminDashboard client:load />
  </section>
</BaseLayout>
