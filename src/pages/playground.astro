---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MultiPlayground from '@/components/playground/MultiPlayground';
---

<BaseLayout
  title="Universal Live Playground"
  description="Write and run HTML, CSS, JavaScript, React JSX, Python 3, SQL, PHP 8, TypeScript, Node.js, C, C++, Java 21, C#, Bash, and Git right in your browser."
>
  <div class="mx-auto max-w-[82rem] px-5 py-10 sm:px-6 lg:px-8">
    <header class="mb-6">
      <span class="inline-flex items-center rounded-full bg-[var(--accent-soft)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-[var(--accent)]">
        13 Live Runtimes
      </span>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-[var(--text)]">
        Universal Live Playground
      </h1>
      <p class="mt-1.5 text-sm text-[var(--text-muted)]">
        Switch between Web, React JSX, WebAssembly (Python, SQL, PHP), Live Compilers (C, C++, Java 21, C#, TypeScript, Node.js, Bash), and Git.
      </p>
    </header>

    <MultiPlayground client:load />
  </div>
</BaseLayout>
