---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { CourseEntry, LessonEntry, ModuleGroup } from '@/lib/courses';
import LessonCompleteButton from '@/components/progress/LessonCompleteButton';
import LessonStudyTools from '@/components/progress/LessonStudyTools';
import SidebarProgress from '@/components/progress/SidebarProgress';
import type { MarkdownHeading } from 'astro';

interface NavLesson {
  title: string;
  href: string;
}

interface Props {
  course: CourseEntry;
  lesson: LessonEntry;
  lessonSlug: string;
  lessonKey: string;
  modules: ModuleGroup[];
  totalLessons: number;
  headings: MarkdownHeading[];
  prevLesson?: NavLesson;
  nextLesson?: NavLesson;
}

const {
  course,
  lesson,
  lessonSlug,
  lessonKey,
  modules,
  totalLessons,
  headings,
  prevLesson,
  nextLesson,
} = Astro.props;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: lesson.data.title,
  description: lesson.data.description,
  educationalLevel: course.data.difficulty,
  isAccessibleForFree: true,
  timeRequired: `PT${lesson.data.durationMinutes}M`,
  isPartOf: {
    '@type': 'Course',
    name: course.data.title,
    description: course.data.description,
  },
};

const sidebarModules = modules.map((m) => ({
  name: m.name,
  lessons: m.lessons.map((l) => ({
    title: l.entry.data.title,
    href: l.href,
    key: l.key,
    durationMinutes: l.entry.data.durationMinutes,
  })),
}));
---

<BaseLayout title={`${lesson.data.title}: ${course.data.shortTitle}`} description={lesson.data.description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-[82rem] px-5 sm:px-6 lg:px-8">
    <!-- Mobile Syllabus Drawer Toggle -->
    <div class="py-3 lg:hidden">
      <details class="group rounded-2xl bg-[var(--bg-elevated)] px-4 py-3">
        <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-[var(--text)]">
          <span>{course.data.shortTitle} · Course Syllabus</span>
          <span class="text-xs font-medium text-[var(--accent)] group-open:hidden">Show lessons</span>
          <span class="hidden text-xs font-medium text-[var(--accent)] group-open:inline">Hide lessons</span>
        </summary>
        <div class="mt-3 max-h-80 overflow-y-auto pt-2">
          <SidebarProgress
            client:idle
            courseSlug={course.data.slug}
            courseTitle={course.data.shortTitle}
            currentKey={lessonKey}
            modules={sidebarModules}
            totalLessons={totalLessons}
          />
        </div>
      </details>
    </div>

    <div class="grid grid-cols-1 gap-10 py-8 lg:grid-cols-[16.5rem_minmax(0,1fr)] xl:grid-cols-[16.5rem_minmax(0,1fr)_13.5rem]">
      <!-- Left Sidebar: Syllabus + Live Progress -->
      <aside class="hidden lg:block" aria-label="Course syllabus">
        <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pr-2">
          <a
            href={`/courses/${course.data.slug}`}
            class="mb-4 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-[var(--accent)] hover:underline"
          >
            ← {course.data.shortTitle}
          </a>
          <SidebarProgress
            client:load
            courseSlug={course.data.slug}
            courseTitle={course.data.shortTitle}
            currentKey={lessonKey}
            modules={sidebarModules}
            totalLessons={totalLessons}
          />
        </div>
      </aside>

      <!-- Center: Lesson Content -->
      <article data-pagefind-body class="min-w-0">
        <header class="mb-8 pb-2">
          <div class="mb-3 flex flex-wrap items-center gap-2 text-xs font-medium text-[var(--text-subtle)]">
            <span class="rounded-full bg-[var(--accent-soft)] px-3 py-0.5 font-semibold text-[var(--accent)]">
              {lesson.data.module}
            </span>
            <span>·</span>
            <span>{lesson.data.durationMinutes} min read</span>
            <span>·</span>
            <span>{course.data.difficulty}</span>
          </div>

          <h1 class="text-3xl font-extrabold tracking-tight text-[var(--text)] sm:text-4xl">
            {lesson.data.title}
          </h1>
          <p class="mt-3 text-lg text-[var(--text-muted)]">
            {lesson.data.description}
          </p>

          {lesson.data.objectives.length > 0 && (
            <div class="mt-6 rounded-2xl bg-[var(--bg-elevated)] p-6">
              <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--text-subtle)]">
                What you'll learn
              </h2>
              <ul class="mt-3 space-y-2 text-sm text-[var(--text-muted)]">
                {lesson.data.objectives.map((obj) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--accent)]" />
                    <span>{obj}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </header>

        <div class="lesson-prose prose prose-slate max-w-none dark:prose-invert">
          <slot />
        </div>

        <!-- Lesson Completion, Study Notes & Prev/Next Footer -->
        <div class="mt-14 flex flex-col gap-5 pt-4" data-pagefind-ignore>
          <LessonStudyTools
            client:load
            lessonKey={lessonKey}
            lessonTitle={lesson.data.title}
            courseTitle={course.data.title}
            href={`/courses/${course.data.slug}/${lessonSlug}`}
          />

          <LessonCompleteButton
            client:load
            lessonKey={lessonKey}
            courseSlug={course.data.slug}
            courseTitle={course.data.title}
            lessonSlug={lessonSlug}
            lessonTitle={lesson.data.title}
            href={`/courses/${course.data.slug}/${lessonSlug}`}
          />

          <nav aria-label="Lesson pagination" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {prevLesson ? (
              <a
                href={prevLesson.href}
                class="group rounded-2xl bg-[var(--bg-elevated)] p-5 transition hover:-translate-y-0.5"
              >
                <div class="text-xs font-medium text-[var(--text-subtle)]">← Previous lesson</div>
                <div class="mt-1 font-semibold text-[var(--text)] group-hover:text-[var(--accent)]">
                  {prevLesson.title}
                </div>
              </a>
            ) : (
              <div />
            )}

            {nextLesson && (
              <a
                href={nextLesson.href}
                class="group rounded-2xl bg-[var(--bg-elevated)] p-5 text-right transition hover:-translate-y-0.5"
              >
                <div class="text-xs font-medium text-[var(--text-subtle)]">Next lesson →</div>
                <div class="mt-1 font-semibold text-[var(--text)] group-hover:text-[var(--accent)]">
                  {nextLesson.title}
                </div>
              </a>
            )}
          </nav>
        </div>
      </article>

      <!-- Right Sidebar: On This Page TOC -->
      <aside class="hidden xl:block" aria-label="On this page">
        <div class="sticky top-24">
          {tocHeadings.length > 0 && (
            <div>
              <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--text-subtle)]">
                On this page
              </h2>
              <ul class="mt-3 space-y-2 text-xs">
                {tocHeadings.map((h) => (
                  <li class={h.depth === 3 ? 'pl-3' : ''}>
                    <a
                      href={`#${h.slug}`}
                      class="block text-[var(--text-muted)] transition hover:text-[var(--text)]"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
