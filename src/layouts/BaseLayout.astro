---
import '@/styles/global.css';
import SearchModal from '@/components/layout/SearchModal.astro';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = 'Free, interactive, open web development courses with live Try-It-Yourself playgrounds and quizzes.',
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('color-scheme');
        if (saved === 'light' || saved === 'dark') {
          document.querySelector('meta[name="color-scheme"]').content = saved;
        }
      } catch {}
    </script>
    <title>{title} | SkillForge</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${title} | SkillForge`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL('/og-card.svg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen bg-[var(--bg)] text-[var(--text)] antialiased selection:bg-[var(--accent-soft)] selection:text-[var(--accent)]">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-[var(--accent)] focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 bg-[color-mix(in_srgb,var(--bg)_92%,transparent)] backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-[82rem] items-center justify-between gap-4 px-5 sm:px-6 lg:px-8">
        <div class="flex items-center gap-7">
          <a href="/" class="flex items-center gap-2.5 font-extrabold tracking-tight text-[var(--text)]">
            <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-[var(--accent)] text-sm font-black text-white">
              SF
            </span>
            <span class="text-lg">SkillForge</span>
          </a>

          <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
            <a
              href="/courses"
              class:list={[
                'inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm font-medium transition',
                currentPath.startsWith('/courses')
                  ? 'bg-[var(--bg-elevated)] font-semibold text-[var(--text)]'
                  : 'text-[var(--text-muted)] hover:bg-[var(--bg-muted)] hover:text-[var(--text)]',
              ]}
            >
              <svg class="h-4 w-4 opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
              </svg>
              <span>Courses</span>
            </a>
            <a
              href="/paths"
              class:list={[
                'inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm font-medium transition',
                currentPath.startsWith('/paths')
                  ? 'bg-[var(--bg-elevated)] font-semibold text-[var(--text)]'
                  : 'text-[var(--text-muted)] hover:bg-[var(--bg-muted)] hover:text-[var(--text)]',
              ]}
            >
              <svg class="h-4 w-4 opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="6" cy="19" r="3" />
                <path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15" />
                <circle cx="18" cy="5" r="3" />
              </svg>
              <span>Paths</span>
            </a>
            <a
              href="/reference"
              class:list={[
                'inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm font-medium transition',
                currentPath.startsWith('/reference')
                  ? 'bg-[var(--bg-elevated)] font-semibold text-[var(--text)]'
                  : 'text-[var(--text-muted)] hover:bg-[var(--bg-muted)] hover:text-[var(--text)]',
              ]}
            >
              <svg class="h-4 w-4 opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
              </svg>
              <span>Reference</span>
            </a>
            <a
              href="/playground"
              class:list={[
                'inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm font-medium transition',
                currentPath.startsWith('/playground')
                  ? 'bg-[var(--bg-elevated)] font-semibold text-[var(--text)]'
                  : 'text-[var(--text-muted)] hover:bg-[var(--bg-muted)] hover:text-[var(--text)]',
              ]}
            >
              <svg class="h-4 w-4 opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="4 17 10 11 4 5" />
                <line x1="12" y1="19" x2="20" y2="19" />
              </svg>
              <span>Playground</span>
            </a>
            <a
              href="/progress"
              class:list={[
                'inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm font-medium transition',
                currentPath.startsWith('/progress')
                  ? 'bg-[var(--bg-elevated)] font-semibold text-[var(--text)]'
                  : 'text-[var(--text-muted)] hover:bg-[var(--bg-muted)] hover:text-[var(--text)]',
              ]}
            >
              <svg class="h-4 w-4 opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="8" r="6" />
                <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
              </svg>
              <span>My Progress</span>
            </a>
          </nav>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            data-open-search
            class="flex items-center gap-2 rounded-full bg-[var(--bg-elevated)] px-3.5 py-1.5 text-sm text-[var(--text-muted)] transition hover:text-[var(--text)]"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <span class="hidden sm:inline">Search</span>
            <kbd class="hidden rounded-full bg-[var(--bg-muted)] px-2 py-0.5 text-[11px] font-medium sm:inline">
              ⌘K
            </kbd>
          </button>

          <button
            type="button"
            id="theme-toggle-btn"
            class="flex h-9 w-9 items-center justify-center rounded-full bg-[var(--bg-elevated)] text-[var(--text-muted)] transition hover:text-[var(--text)]"
          >
            <span class="theme-icon-dark items-center">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
              </svg>
              <span class="sr-only">Switch to dark theme</span>
            </span>
            <span class="theme-icon-light items-center">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
              </svg>
              <span class="sr-only">Switch to light theme</span>
            </span>
          </button>

          <!-- Mobile Navigation Menu -->
          <details class="relative md:hidden">
            <summary
              aria-label="Open navigation menu"
              class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full bg-[var(--bg-elevated)] text-[var(--text-muted)] hover:text-[var(--text)]"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </summary>
            <nav
              aria-label="Mobile navigation"
              class="absolute right-0 mt-2 w-48 rounded-2xl bg-[var(--bg-elevated)] p-2 shadow-lg"
            >
              <a href="/courses" class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-[var(--text)] hover:bg-[var(--bg-muted)]">
                <svg class="h-4 w-4 opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                </svg>
                <span>Courses</span>
              </a>
              <a href="/paths" class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-[var(--text)] hover:bg-[var(--bg-muted)]">
                <svg class="h-4 w-4 opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="6" cy="19" r="3" />
                  <path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15" />
                  <circle cx="18" cy="5" r="3" />
                </svg>
                <span>Paths</span>
              </a>
              <a href="/reference" class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-[var(--text)] hover:bg-[var(--bg-muted)]">
                <svg class="h-4 w-4 opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
                </svg>
                <span>Reference</span>
              </a>
              <a href="/playground" class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-[var(--text)] hover:bg-[var(--bg-muted)]">
                <svg class="h-4 w-4 opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="4 17 10 11 4 5" />
                  <line x1="12" y1="19" x2="20" y2="19" />
                </svg>
                <span>Playground</span>
              </a>
              <a href="/progress" class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-[var(--text)] hover:bg-[var(--bg-muted)]">
                <svg class="h-4 w-4 opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="8" r="6" />
                  <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
                </svg>
                <span>My Progress</span>
              </a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="mt-24 bg-[#0b0f14] text-white/70">
      <div class="mx-auto flex max-w-[82rem] flex-col items-center justify-between gap-4 px-5 py-10 text-sm sm:flex-row sm:px-6 lg:px-8">
        <p>
          <strong class="font-semibold text-white">SkillForge</strong>: Free, interactive web courses. No login required.
        </p>
        <div class="flex items-center gap-6">
          <a href="/courses" class="transition hover:text-white">Courses</a>
          <a href="/reference" class="transition hover:text-white">Reference</a>
          <a href="/playground" class="transition hover:text-white">Playground</a>
          <a href="/progress" class="transition hover:text-white">My Progress</a>
        </div>
      </div>
    </footer>

    <SearchModal />

    <script>
      const meta = document.querySelector('meta[name="color-scheme"]') as HTMLMetaElement | null;
      const toggleBtn = document.getElementById('theme-toggle-btn');

      function getSystemScheme(): 'light' | 'dark' {
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function getCurrentRenderedScheme(): 'light' | 'dark' {
        const content = meta?.content;
        if (content === 'light' || content === 'dark') return content;
        return getSystemScheme();
      }

      toggleBtn?.addEventListener('click', () => {
        if (!meta) return;
        const target = getCurrentRenderedScheme() === 'dark' ? 'light' : 'dark';
        const system = getSystemScheme();
        try {
          if (target === system) {
            localStorage.removeItem('color-scheme');
            meta.content = 'light dark';
          } else {
            localStorage.setItem('color-scheme', target);
            meta.content = target;
          }
        } catch {
          meta.content = target;
        }
      });

      window.addEventListener('storage', (e) => {
        if (e.key === 'color-scheme' && meta) {
          meta.content = e.newValue === 'light' || e.newValue === 'dark' ? e.newValue : 'light dark';
        }
      });
    </script>
  </body>
</html>
